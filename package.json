{
  "name": "dsh-hydradb",
  "version": "0.1.0",
  "description": "Persistent long-term memory for the DeepSeek Harness (dsh) via HydraDB: prompt-time recall, workspace sync, and turn capture over the harness Cordis seams.",
  "author": "HydraDB <support@hydradb.com>",
  "license": "Apache-2.0",
  "homepage": "https://docs.hydradb.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydra-db/hydradb-deepseek-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/hydra-db/hydradb-deepseek-plugin/issues"
  },
  "keywords": [
    "hydradb",
    "memory",
    "retrieval",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "knowledge-base"
  ],
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh.config.example.yml",
    "skills",
    "scripts",
    "hydradb-api-info",
    "config.example.json",
    ".hydradb-plugin.json.example",
    "CONTRACT.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "devDependencies": {
    "@hydradb/sdk": "2.1.2",
    "esbuild": "0.28.1"
  }
}
